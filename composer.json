{
    "name": "demo/capp",
    "description": "DEMO CAPP application baseline",
    "license": "proprietary",
    "type": "project",
    "require": {
        "php": "^8.3",
        "nikic/fast-route": "^1.3",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "CApp\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CApp\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --no-progress"
    },
    "config": {
        "sort-packages": true
    }
}
